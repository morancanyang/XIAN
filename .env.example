# XIAN 环境变量示例。复制为 .env 后按需修改。
# 所有变量均可留空：未配置时系统自动降级到 SQLite / 内存 / 本地 outputs，
# LLM 走确定性离线回放。详见 docs/deployment.md。

# ---- 基础 ----
XIAN_ENV=dev
XIAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据层（可选）----
XIAN_DB_DSN=
XIAN_REDIS_URL=
XIAN_CELERY_BROKER_URL=
XIAN_CLICKHOUSE_DSN=
XIAN_QDRANT_URL=
XIAN_S3_ENDPOINT=
XIAN_S3_ACCESS_KEY=
XIAN_S3_SECRET_KEY=

# ---- LLM 网关（可选，未配置走离线回放）----
# 只填 Key 即可：会按 DEEPSEEK_API_KEY / DASHSCOPE_API_KEY / MOONSHOT_API_KEY /
# SILICONFLOW_API_KEY / ZHIPU_API_KEY / OPENAI_API_KEY 反推端点与默认模型。
XIAN_LLM_PROVIDER=
XIAN_LLM_BASE_URL=
XIAN_LLM_API_KEY=
XIAN_LLM_REDTEAM_MODEL=
XIAN_LLM_TARGET_MODEL=
XIAN_LLM_JUDGE_MODEL=
XIAN_LLM_EMBEDDING_MODEL=
XIAN_LLM_FALLBACK_MODEL=
XIAN_LLM_TIMEOUT_S=60
XIAN_LLM_MAX_RETRIES=2

# 接入自建网关（vLLM / Ollama / LiteLLM Proxy）时显式指定 OpenAI 兼容端点：
# XIAN_LLM_BASE_URL=http://127.0.0.1:4000
# XIAN_LLM_API_KEY=sk-local

# ---- 裁判与输出 ----
XIAN_JUDGE_MODE=standard
XIAN_OUTPUT_MODE=full

# ---- 沙箱与出口代理 ----
XIAN_EGRESS_ALLOWLIST=api.openai.com,api.anthropic.com,registry.npmjs.org,pypi.org

# ---- 演示被测 Agent（examples/demo-agent）----
XIAN_DEMO_PORT=9001
XIAN_DEMO_NONCE=xian-demo-nonce
XIAN_DEMO_TOKEN=demo-canary-token
# 系统提示词泄露时必须逐字漏出的蜜标，须与黄金信号 G-08 的 sk-canary-[A-Za-z0-9]{6,} 同形：
# 提示词里没有蜜标的话，泄露内容再多也没有确定性证据可判，整场战役会全部落到“未命中”。
XIAN_DEMO_CANARY=sk-canary-demo0001
XIAN_DEMO_REQUIRE_AUTH=0
XIAN_DEMO_LATENCY_MS=40
XIAN_DEMO_FAIL_RATE=0.0
